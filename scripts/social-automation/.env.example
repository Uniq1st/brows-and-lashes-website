# Copy this to .env for local testing
# NEVER commit your actual .env file — it's in .gitignore

# Content generation (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Image hosting (cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# Instagram — UES (Brows & Lashes @browsandlashesnyc)
META_UES_IG_USER_ID=17841400000000000
META_UES_ACCESS_TOKEN=EAAxxxxxxxx...

# Instagram — Ridgewood (Eyebrow Shape @eyebrowshapenyc)
META_RIDGEWOOD_IG_USER_ID=17841400000000001
META_RIDGEWOOD_ACCESS_TOKEN=EAAxxxxxxxx...

# Facebook Page — UES (separate from the Instagram token above; needs
# pages_manage_posts + pages_read_engagement, exchanged for a long-lived token)
META_UES_FB_PAGE_ID=123456789012345
META_UES_FB_PAGE_TOKEN=EAAxxxxxxxx...

# Facebook Page — Ridgewood
META_RIDGEWOOD_FB_PAGE_ID=123456789012346
META_RIDGEWOOD_FB_PAGE_TOKEN=EAAxxxxxxxx...

# Google Business Profile
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_UES_LOCATION_NAME=accounts/123456789/locations/987654321
GOOGLE_RIDGEWOOD_LOCATION_NAME=accounts/123456789/locations/987654322

# Square — reuses the SAME tokens as the website (lib/square.ts / .env.local),
# needed here with write (not just read) scope for update-square-catalog.mjs
SQUARE_UES_ACCESS_TOKEN=...
SQUARE_RIDGEWOOD_ACCESS_TOKEN=...
